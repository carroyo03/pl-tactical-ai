# Azure settings are read by the API process. The explicit local launcher loads .env.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Set in the Streamlit process to use the API; unset for the offline studio.
API_BASE_URL=http://127.0.0.1:8000
# Optional service boundary for a remotely hosted API. Keep real values private.
API_SERVICE_TOKEN=
REQUIRE_API_SERVICE_TOKEN=false
# The public Azure demo explicitly disables paid model selection.
DISABLE_PAID_MODELS=false

# Local Groq studio only. A key alone never enables inference.
# Launch with: uv run python scripts/run_groq_studio.py
GROQ_MODEL=openai/gpt-oss-120b
# Set by the local launcher; leave unset for the normal offline application.
LLM_PROVIDER=
# Groq credentials (keep real values only in the ignored .env).
GROQ_API_KEY=your_groq_api_key_here
